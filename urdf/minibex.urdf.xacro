<?xml version="1.0" encoding="UTF-8"?>
<robot name="minibex" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Minibex URDF（xacro化）。移植元: minibex_robot.urdf（ROS1）
    変更点:
      - RL_* → BL_*, RR_* → BR_* にリネーム
      - FL_calf / FR_calf のメッシュ参照バグを修正（RL_calf→FL_calf, RR_calf→FR_calf）
      - メッシュ参照を package://minibex_description/meshes/ へ変更
      - base_link + Base の二層構造を base_link に統合
      - ros2_control セクションを minibex.ros2_control.xacro に分離
      - 慣性テンソルは ROS1 URDFからの転記
  -->

  <xacro:arg name="config_file" default=""/>
  <xacro:arg name="spec_dir" default=""/>
  <xacro:arg name="hardware_mode" default="none"/>
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="headless" default="true"/>
  <xacro:arg name="sim_speed_factor" default="1.0"/>

  <material name="body_color">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="foot_color">
    <color rgba="0.2 0.4 1.0 1.0"/>
  </material>

  <!-- ============ 脚マクロ ============ -->
  <!--
    prefix: BL/BR/FL/FR
    collar_xyz: base_link からの collar joint origin
    collar_axis: collar rotation axis（常に "1 0 0"）
    hip_side: hip joint の y offset（左脚: +0.062, 右脚: -0.062）
    knee_side: knee joint の y offset（左脚: +0.023, 右脚: -0.023）
    scapula_ixy / thigh_ixy / calf_iyz: 慣性テンソルの符号（左右で反転）
    calf_iyz: calf 慣性テンソルの iyz（左脚: -0.000304, 右脚: +0.000304）
  -->
  <xacro:macro name="minibex_leg"
               params="prefix
                       collar_xyz
                       hip_side
                       knee_side
                       scapula_ixy
                       calf_iyz">

    <!-- scapula -->
    <link name="${prefix}_scapula">
      <visual>
        <geometry><mesh filename="package://minibex_description/meshes/${prefix}_scapula.stl"/></geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="body_color"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://minibex_description/meshes/${prefix}_scapula.stl"/></geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="-0.01570 ${0.01850 * scapula_ixy} 0.0"/>
        <mass value="0.255"/>
        <inertia ixx="0.000247" ixy="${0.000076 * scapula_ixy}" ixz="0.0"
                 iyy="0.000214" iyz="0.0" izz="0.000300"/>
      </inertial>
    </link>

    <!-- thigh -->
    <link name="${prefix}_thigh">
      <visual>
        <geometry><mesh filename="package://minibex_description/meshes/${prefix}_thigh.stl"/></geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="body_color"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://minibex_description/meshes/${prefix}_thigh.stl"/></geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0.0 ${0.02620 * hip_side / 0.062} -0.09993"/>
        <mass value="1.538"/>
        <inertia ixx="0.014321" ixy="0.0" ixz="0.0"
                 iyy="0.014628" iyz="0.0" izz="0.001023"/>
      </inertial>
    </link>

    <!-- calf -->
    <link name="${prefix}_calf">
      <visual>
        <geometry><mesh filename="package://minibex_description/meshes/${prefix}_calf.stl"/></geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="body_color"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://minibex_description/meshes/${prefix}_calf.stl"/></geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0.03971 ${-0.00984 * scapula_ixy} -0.08495"/>
        <mass value="0.457"/>
        <inertia ixx="0.003103" ixy="0.0" ixz="0.000696"
                 iyy="0.003545" iyz="${calf_iyz}" izz="0.000640"/>
      </inertial>
    </link>

    <!-- foot -->
    <link name="${prefix}_foot">
      <visual>
        <geometry><sphere radius="0.03"/></geometry>
        <material name="foot_color"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.03"/></geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="0.035"/>
        <inertia ixx="0.000006" ixy="0.0" ixz="0.0"
                 iyy="0.000006" iyz="0.0" izz="0.000006"/>
      </inertial>
    </link>

    <!-- joints -->
    <joint name="${prefix}_collar_joint" type="revolute">
      <limit lower="-1.57" upper="1.57" effort="65.6" velocity="19.90"/>
      <parent link="base_link"/>
      <child link="${prefix}_scapula"/>
      <axis xyz="1 0 0"/>
      <origin xyz="${collar_xyz}" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_hip_joint" type="revolute">
      <limit lower="-3.14" upper="3.14" effort="65.6" velocity="19.90"/>
      <parent link="${prefix}_scapula"/>
      <child link="${prefix}_thigh"/>
      <axis xyz="0 1 0"/>
      <origin xyz="0 ${hip_side} 0" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_knee_joint" type="revolute">
      <limit lower="-2.618" upper="0.0" effort="65.6" velocity="19.90"/>
      <parent link="${prefix}_thigh"/>
      <child link="${prefix}_calf"/>
      <axis xyz="0 1 0"/>
      <origin xyz="0 ${knee_side} -0.20" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}_ankle_joint" type="fixed" dont_collapse="true">
      <origin xyz="0 0 -0.21541" rpy="0 0 0"/>
      <parent link="${prefix}_calf"/>
      <child link="${prefix}_foot"/>
    </joint>

  </xacro:macro>

  <!-- ============ world / base_link ============ -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://minibex_description/meshes/Base.stl"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="body_color"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://minibex_description/meshes/Base.stl"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00544 -0.00131 0.00160"/>
      <mass value="8.200"/>
      <inertia ixx="0.045765" ixy="0.000433" ixz="0.001644"
               iyy="0.132502" iyz="0.000600" izz="0.158906"/>
    </inertial>
  </link>

  <!-- ============ 4脚（BL/BR/FL/FR 順） ============ -->
  <!--
    scapula_ixy: 左脚 +1, 右脚 -1（y方向慣性テンソル符号）
    calf_iyz: 左脚 -0.000304, 右脚 +0.000304
    hip_side: 左脚 +0.062, 右脚 -0.062
    knee_side: 左脚 +0.023, 右脚 -0.023
  -->
  <xacro:minibex_leg prefix="BL"
    collar_xyz="-0.251 0.073 0"
    hip_side="0.062"  knee_side="0.023"
    scapula_ixy="1"   calf_iyz="-0.000304"/>

  <xacro:minibex_leg prefix="BR"
    collar_xyz="-0.251 -0.073 0"
    hip_side="-0.062" knee_side="-0.023"
    scapula_ixy="-1"  calf_iyz="0.000304"/>

  <xacro:minibex_leg prefix="FL"
    collar_xyz="0.251 0.073 0"
    hip_side="0.062"  knee_side="0.023"
    scapula_ixy="1"   calf_iyz="-0.000304"/>

  <xacro:minibex_leg prefix="FR"
    collar_xyz="0.251 -0.073 0"
    hip_side="-0.062" knee_side="-0.023"
    scapula_ixy="-1"  calf_iyz="0.000304"/>

  <!-- ============ ros2_control ============ -->
  <xacro:if value="${'$(arg hardware_mode)' != 'none'}">
    <xacro:include filename="$(find minibex_description)/urdf/minibex.ros2_control.xacro"/>
    <xacro:property name="standalone_mode" value="$(arg hardware_mode)"/>
    <xacro:unless value="${standalone_mode in ['mock', 'bxi', 'mujoco']}">
      ${xacro.fatal('hardware_mode must be none, mock, bxi, or mujoco')}
    </xacro:unless>
    <xacro:if value="${standalone_mode in ['mock', 'bxi']}">
      <xacro:minibex_standalone_ros2_control
        hardware_mode="${standalone_mode}"
        config_file="$(arg config_file)"
        spec_dir="$(arg spec_dir)"/>
    </xacro:if>
    <xacro:if value="${standalone_mode == 'mujoco'}">
      <xacro:property name="mujoco_model_value"
        value="${'$(arg mujoco_model)' if '$(arg mujoco_model)' != '' else xacro.fatal('mujoco_model is required when hardware_mode is mujoco')}"/>
      <xacro:minibex_mujoco_ros2_control
        mujoco_model="${mujoco_model_value}"
        headless="$(arg headless)"
        sim_speed_factor="$(arg sim_speed_factor)"/>
    </xacro:if>
  </xacro:if>

</robot>
